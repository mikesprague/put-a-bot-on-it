{
  "name": "put-a-bot-on-it",
  "version": "0.1.0",
  "private": "true",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Michael Sprague",
    "email": "mikesprague@gmail.com"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "declarations": "rm -rf ./types && tsc --emitDeclarationOnly --declaration true --declarationDir './types'",
    "dev": "NODE_ENV=development bun --watch --inspect=0.0.0.0:9229 run ./src/index.ts ",
    "do-co:up": "docker-compose -f ./docker-compose.dev.yml up",
    "do-co:down": "docker-compose -f ./docker-compose.dev.yml down --rmi 'all'",
    "format": "bun x oxfmt src",
    "format:check": "bun x oxfmt --check src",
    "lint": "bun x oxlint src",
    "prestart": "bun run slash-deploy",
    "slash-deploy": "NODE_ENV=production bun run ./src/deploy-slash-commands.ts",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production bun run ./src/index.ts",
    "test": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "common-tags": "1.8.2",
    "dayjs": "1.11.23",
    "discord.js": "14.27.0",
    "he": "1.2.0",
    "openai": "7.10.0",
    "randomcolor": "0.6.2"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/he": "^1.2.3",
    "@types/node": "26.5.0",
    "@types/randomcolor": "^0.5.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun": "1.4.2",
    "bun-types": "1.4.2",
    "cz-git": "1.14.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "engines": {
    "bun": ">= 1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
